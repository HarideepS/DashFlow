<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plate base border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1D24" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <!-- White Plate Face with black border -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#F7FAFC" />
            <stroke
                android:width="1.5dp"
                android:color="#1A202C" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
