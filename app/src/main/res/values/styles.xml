<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SwiftCarLauncher" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg_dashboard</item>
        <item name="android:statusBarColor">@color/bg_dashboard</item>
        <item name="android:navigationBarColor">@color/bg_dashboard</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.SwiftCarLauncher.AppDrawer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/overlay_dim</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
