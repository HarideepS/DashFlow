<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dashboard"
    android:paddingStart="@dimen/root_padding_h"
    android:paddingTop="@dimen/root_padding_v"
    android:paddingEnd="@dimen/root_padding_h"
    android:paddingBottom="@dimen/root_padding_v">

    <!-- ======================================================== -->
    <!-- LEFT PANEL: Clock, Day, Speed, Weather, Car, Controls    -->
    <!-- ======================================================== -->

    <!-- Clock & Day Container (Tap to toggle 12h / 24h) -->
    <LinearLayout
        android:id="@+id/clockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/speedometerContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="@color/text_time"
            android:textSize="@dimen/clock_text_size"
            tools:text="12:14 AM" />

        <TextView
            android:id="@+id/textDayDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#4D7DF0"
            android:textSize="@dimen/day_text_size"
            tools:text="Thursday" />
    </LinearLayout>

    <!-- GPS Speedometer Pill (Tap to toggle KM/H vs MPH or grant GPS) -->
    <LinearLayout
        android:id="@+id/speedometerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/panel_gap"
        android:background="@drawable/bg_toggle_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/speed_min_width"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/speed_value_text_size"
            android:textStyle="bold"
            tools:text="42" />

        <TextView
            android:id="@+id/textSpeedUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="KM/H"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/speed_unit_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Weather container with condition icon and location/temp -->
    <LinearLayout
        android:id="@+id/weatherContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@+id/speedometerContainer"
        app:layout_constraintStart_toStartOf="@+id/clockContainer"
        app:layout_constraintTop_toBottomOf="@+id/clockContainer">

        <ImageView
            android:id="@+id/iconWeather"
            android:layout_width="@dimen/weather_icon_size"
            android:layout_height="@dimen/weather_icon_size"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_weather_drizzle" />

        <TextView
            android:id="@+id/textWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/default_weather"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/weather_text_size"
            tools:text="Hyderabad, 24°C Clear" />
    </LinearLayout>

    <!-- Center Hero: Customizable Car (clipped cleanly inside its bounds) -->
    <FrameLayout
        android:id="@+id/carFrameContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/panel_gap"
        android:layout_marginBottom="4dp"
        android:clipChildren="true"
        app:layout_constraintBottom_toTopOf="@+id/vehicleInfoContainer"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weatherContainer">

        <ImageView
            android:id="@+id/imageCar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:contentDescription="Car Dashboard Display"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/car_swift" />
    </FrameLayout>

    <!-- Vehicle Info Badge: Model Name & Optional License Plate (Tap to customize) -->
    <LinearLayout
        android:id="@+id/vehicleInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/panel_gap"
        android:layout_marginBottom="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/mediaControllerBar"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="6dp">

        <TextView
            android:id="@+id/textVehicleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="#C5D0E6"
            android:textSize="@dimen/vehicle_name_text_size"
            android:textStyle="bold"
            tools:text="HATCHBACK" />

        <TextView
            android:id="@+id/textLicensePlate"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_license_plate"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:textColor="#1A202C"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="ABC 1234"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Headless Media Controller Pill (Auto-shown only when media playback is active) -->
    <LinearLayout
        android:id="@+id/mediaControllerBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/media_bar_height"
        android:layout_marginEnd="@dimen/panel_gap"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_toggle_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/togglesContainer"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/mediaTrackInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textMediaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Blinding Lights" />

            <TextView
                android:id="@+id/textMediaArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                tools:text="The Weeknd" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMediaPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Track"
            android:src="@drawable/ic_media_prev"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnMediaPlayPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play or Pause"
            android:src="@drawable/ic_media_play"
            app:tint="#4D7DF0" />

        <ImageButton
            android:id="@+id/btnMediaNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Track"
            android:src="@drawable/ic_media_next"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Bottom Quick Controls Bar: Exactly 4 Toggles (Wi-Fi, Bluetooth, Auto Bright, Volume) -->
    <LinearLayout
        android:id="@+id/togglesContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/toggles_height"
        android:layout_marginEnd="@dimen/panel_gap"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. Wi-Fi Toggle -->
        <LinearLayout
            android:id="@+id/btnWifi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/toggle_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_toggle_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iconWifi"
                android:layout_width="@dimen/toggle_icon_size"
                android:layout_height="@dimen/toggle_icon_size"
                android:src="@drawable/ic_wifi"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/labelWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/wifi"
                android:textColor="@color/toggle_text"
                android:textSize="@dimen/toggle_text_size"
                app:autoSizeMaxTextSize="@dimen/toggle_text_size"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- 2. Bluetooth Toggle -->
        <LinearLayout
            android:id="@+id/btnBluetooth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/toggle_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_toggle_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iconBluetooth"
                android:layout_width="@dimen/toggle_icon_size"
                android:layout_height="@dimen/toggle_icon_size"
                android:src="@drawable/ic_bluetooth"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/labelBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/bluetooth"
                android:textColor="@color/toggle_text"
                android:textSize="@dimen/toggle_text_size"
                app:autoSizeMaxTextSize="@dimen/toggle_text_size"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- 3. Auto Brightness Toggle -->
        <LinearLayout
            android:id="@+id/btnBrightness"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/toggle_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_toggle_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iconBrightness"
                android:layout_width="@dimen/toggle_icon_size"
                android:layout_height="@dimen/toggle_icon_size"
                android:src="@drawable/ic_brightness"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/labelBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/auto_brightness"
                android:textColor="@color/toggle_text"
                android:textSize="@dimen/toggle_text_size"
                app:autoSizeMaxTextSize="@dimen/toggle_text_size"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- 4. System Media Volume Toggle (Mute / Unmute) -->
        <LinearLayout
            android:id="@+id/btnVolume"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_toggle_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iconVolume"
                android:layout_width="@dimen/toggle_icon_size"
                android:layout_height="@dimen/toggle_icon_size"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/labelVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/volume"
                android:textColor="@color/toggle_text"
                android:textSize="@dimen/toggle_text_size"
                app:autoSizeMaxTextSize="@dimen/toggle_text_size"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </LinearLayout>

    <!-- Guideline dividing Left (~58%) and Right (~42%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.58" />

    <!-- ================================================================== -->
    <!-- RIGHT PANEL: Symmetrical 2x2 Grid with Stacked Settings & All Apps -->
    <!-- Row 1: Android Auto (Square) | Apple CarPlay (Square)              -->
    <!-- Row 2: YouTube (Square)      | Settings (Rect) / All Apps (Rect)   -->
    <!-- ================================================================== -->
    <LinearLayout
        android:id="@+id/rightPanelContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="parent">

        <!-- TOP ROW: Android Auto & Apple CarPlay (Squares) -->
        <LinearLayout
            android:id="@+id/rowTopCards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/card_gap"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- SQUARE 1: Android Auto -->
            <LinearLayout
                android:id="@+id/cardAndroidAuto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/card_half_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_frosted_square"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/iconCardAA"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:maxWidth="@dimen/square_card_icon_max"
                    android:maxHeight="@dimen/square_card_icon_max"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_aa_custom" />

                <TextView
                    android:id="@+id/textCardAA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/android_auto"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/square_card_text_size"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="@dimen/square_card_text_size"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <!-- SQUARE 2: Apple CarPlay -->
            <LinearLayout
                android:id="@+id/cardCarPlay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/card_half_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_frosted_square"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/iconCardCarPlay"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:maxWidth="@dimen/square_card_icon_max"
                    android:maxHeight="@dimen/square_card_icon_max"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_carplay_custom" />

                <TextView
                    android:id="@+id/textCardCarPlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/apple_carplay"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/square_card_text_size"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="@dimen/square_card_text_size"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

        </LinearLayout>

        <!-- BOTTOM ROW: YouTube (Square) + Stacked Settings / All Apps (2 Rectangles) -->
        <LinearLayout
            android:id="@+id/rowBottomCards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- SQUARE 3: YouTube -->
            <LinearLayout
                android:id="@+id/cardYouTube"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/card_half_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_frosted_square"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/iconCardYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:maxWidth="@dimen/square_card_icon_max"
                    android:maxHeight="@dimen/square_card_icon_max"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_youtube"
                    app:tint="#FF0000" />

                <TextView
                    android:id="@+id/textCardYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/youtube"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/square_card_text_size"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="@dimen/square_card_text_size"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <!-- QUADRANT 4: TWO RECTANGLES (Settings on Top + All Apps on Bottom) -->
            <LinearLayout
                android:id="@+id/colRightBottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/card_half_gap"
                android:layout_weight="1"
                android:orientation="vertical"
                android:weightSum="2">

                <!-- RECTANGLE 1: Settings -->
                <LinearLayout
                    android:id="@+id/cardSettings"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/card_half_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_frosted_rect"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/rect_card_padding_h"
                    android:paddingEnd="@dimen/rect_card_padding_h">

                    <ImageView
                        android:id="@+id/iconCardSettings"
                        android:layout_width="@dimen/rect_card_icon_size"
                        android:layout_height="@dimen/rect_card_icon_size"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/textCardSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/settings"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/rect_card_text_size"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="@dimen/rect_card_text_size"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <ImageView
                        android:layout_width="@dimen/chevron_size"
                        android:layout_height="@dimen/chevron_size"
                        android:contentDescription="Open Settings"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#5A6C88" />
                </LinearLayout>

                <!-- RECTANGLE 2: All Apps -->
                <LinearLayout
                    android:id="@+id/cardAllApps"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/card_half_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_frosted_rect"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/rect_card_padding_h"
                    android:paddingEnd="@dimen/rect_card_padding_h">

                    <ImageView
                        android:id="@+id/iconCardAllApps"
                        android:layout_width="@dimen/rect_card_icon_size"
                        android:layout_height="@dimen/rect_card_icon_size"
                        android:src="@drawable/ic_apps"
                        app:tint="#D2D8E3" />

                    <TextView
                        android:id="@+id/textCardAllApps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/all_apps"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/rect_card_text_size"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="@dimen/rect_card_text_size"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <ImageView
                        android:layout_width="@dimen/chevron_size"
                        android:layout_height="@dimen/chevron_size"
                        android:contentDescription="Open App Drawer"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#5A6C88" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
