<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161B26"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_launcher_car" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Vehicle &amp; Dashboard Customizer"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customize vehicle model, plate &amp; dashboard visuals"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="#273042" />

        <!-- 1. VEHICLE IDENTITY SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="1. Vehicle Identity"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Vehicle Name & License Plate (Side-by-side for landscape ergonomics) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Vehicle Model / Display Name"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editVehicleName"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_toggle_pill"
                    android:hint="e.g. Honda Civic, Golf, Creta"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="License Plate (Optional)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editLicensePlate"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_toggle_pill"
                    android:hint="Leave empty to hide"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. CAR VISUAL PRESETS & CUSTOM UPLOAD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="2. Dashboard Car Visual"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Select a built-in preset or pick a custom photo of your own car:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Presets Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetHatchback"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Hatchback"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />

            <Button
                android:id="@+id/btnPresetSedan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Sedan"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />

            <Button
                android:id="@+id/btnPresetSuv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="SUV"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />
        </LinearLayout>

        <!-- Presets Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetSports"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Sports GT"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />

            <Button
                android:id="@+id/btnPresetEv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Cyber EV"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />
        </LinearLayout>

        <!-- Custom Image Picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickCustomImage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="📷 Choose Photo from Gallery"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                app:strokeColor="#3B82F6" />

            <Button
                android:id="@+id/btnClearCustomImage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Clear Photo"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:visibility="gone"
                app:strokeColor="#EF4444" />
        </LinearLayout>

        <TextView
            android:id="@+id/textCarVisualStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Active visual: Hatchback"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 3. CAR DISPLAY SIZING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="3. Car Scale / Display Sizing"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSizeSmall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="85% Compact"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />

            <Button
                android:id="@+id/btnSizeNormal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="100% Default"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />

            <Button
                android:id="@+id/btnSizeLarge"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="115% Hero"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />
        </LinearLayout>

        <!-- 4. WEATHER LOCATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="4. Weather City Location"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editCity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_toggle_pill"
            android:hint="e.g. Hyderabad, London, Los Angeles"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <!-- 5. COCKPIT TELEMETRY, THEME & HEAD-UNIT UTILITIES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="5. Cockpit Telemetry &amp; Head-Unit Utilities"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Accent Color Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dashboard Accent Color"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAccentBlue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Blue"
                android:textColor="#4D7DF0"
                android:textSize="11sp"
                app:strokeColor="#4D7DF0" />

            <Button
                android:id="@+id/btnAccentCyan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Cyan"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                app:strokeColor="#00E5FF" />

            <Button
                android:id="@+id/btnAccentEmerald"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Green"
                android:textColor="#10B981"
                android:textSize="11sp"
                app:strokeColor="#10B981" />

            <Button
                android:id="@+id/btnAccentRed"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Red"
                android:textColor="#EF4444"
                android:textSize="11sp"
                app:strokeColor="#EF4444" />

            <Button
                android:id="@+id/btnAccentAmber"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Amber"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                app:strokeColor="#F59E0B" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/checkShowSpeedometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/card_android_auto"
            android:text="Show live GPS Speedometer pill"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/checkSpeedMph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/card_android_auto"
            android:text="Use MPH instead of KM/H"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/checkAutoDimming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/card_android_auto"
            android:text="Auto-dim screen at sunset / brighten at sunrise"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Headless Media Controller Permission -->
        <Button
            android:id="@+id/btnEnableMediaAccess"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="🎵 Enable Headless Media Bar (Notification Access)"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            app:strokeColor="#3B82F6" />

        <!-- Boot Auto-Launch -->
        <TextView
            android:id="@+id/textBootLaunchApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Auto-Launch on Cold Boot: None"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickBootApp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Pick Boot App"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="#2F3A50" />

            <Button
                android:id="@+id/btnClearBootApp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Clear"
                android:textColor="#F87171"
                android:textSize="12sp"
                app:strokeColor="#EF4444" />
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:backgroundTint="@color/card_android_auto"
                android:fontFamily="sans-serif-medium"
                android:text="Save &amp; Apply"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
